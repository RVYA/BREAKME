{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VariantsCatalogSchema",
  "type": "object",
  "required": [
    "$schema",
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "rarity"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "rarity": {
            "$ref": "./configs.schema.json#/$defs/RarityTier"
          }
        }
      }
    }
  }
}
