{
  "name": "breakme",
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#assets/*": "./src/assets/*",
    "#const/*": "./src/constants/*",
    "#models/*": "./src/models/*",
    "#repos/*": "./src/repos/*",
    "#styles/*": "./src/styles/*",
    "#utils/*": "./src/utils/*"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/engine.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0"
  }
}