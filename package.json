{
  "name": "breakme",
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#data/*": "./src/data/*.ts",
    "#engine": "./src/engine.ts",
    "#input/*": "./src/input/*.ts",
    "#modules/*": "./src/modules/*.ts",
    "#rendering/*": "./src/rendering/*",
    "#state/*": "./src/state/*.ts",
    "#systems/*": "./src/systems/*.ts",
    "#types/*": "./src/types/*.ts",
    "#utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --experimental-strip-types src/engine.ts",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "test:fetch": "node --env-file-if-exists=.env --experimental-strip-types scripts/test-fetch.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0"
  }
}
