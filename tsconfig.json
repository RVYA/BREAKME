{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "types": ["node"],
    "noImplicitAny": true,
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "#data/*": [
        "./src/data/*"
      ],
      "#input/*": [
        "./src/input/*"
      ],
      "#modules/*": [
        "./src/modules/*"
      ],
      "#rendering/*": [
        "./src/rendering/*"
      ],
      "#state/*": [
        "./src/state/*"
      ],
      "#types/*": [
        "./src/types/*"
      ],
      "#utils/*": [
        "./src/utils/*"
      ]
    }
  },
  "exclude": [
    "./node_modules/**"
  ]
}